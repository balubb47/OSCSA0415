for(i = start; i < start + length; i++) {
        if(disk[i] == 1) {
            found = 1;
            break;
        }
    }

    if(found) {
        printf("Blocks are not available\n");
    } else {
        for(i = start; i < start + length; i++)
            disk[i] = 1;

        printf("File allocated successfully\n");
        printf("Allocated blocks: ");

        for(i = start; i < start + length; i++)
            printf("%d ", i);
    }

    return 0;
}
