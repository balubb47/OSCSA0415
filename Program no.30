#include <stdio.h>
#include <pthread.h>
#include <unistd.h>

void *thread_function(void *arg)
{
    int id = *(int *)arg;

    printf("Thread %d is running.\n", id);

    if (id == 2)
    {
        printf("Thread %d is exiting.\n", id);
        pthread_exit(NULL);
    }

    printf("Thread %d completed.\n", id);

    return NULL;
}

int main()
{
    pthread_t t1, t2;
    int id1 = 1, id2 = 2;

    // (i) Thread Create
    pthread_create(&t1, NULL, thread_function, &id1);
    pthread_create(&t2, NULL, thread_function, &id2);

    printf("Threads created successfully.\n");

    // (ii) Thread Equal
    if (pthread_equal(t1, t2))
        printf("Both threads are equal.\n");
    else
        printf("Both threads are not equal.\n");

    // (iii) Thread Join
    pthread_join(t1, NULL);
    pthread_join(t2, NULL);

    printf("Main thread joined successfully.\n");

    // (iv) Thread Exit
    pthread_exit(NULL);

    return 0;
}
